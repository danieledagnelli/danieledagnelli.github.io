---
import { stories, ingredients } from '../game/content';
import { experience, education, skills, languages } from '../data/resume';
import { siteMetadata } from '../siteMetadata';
import '../styles/game.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e5" />
    <title>Operation: Pineapple — Daniele D’Agnelli</title>
    <meta name="description" content="A little adventure about Daniele D’Agnelli. Explore a pixel neighbourhood of science, Italian rap, EDM, family, and unapologetic pineapple pizza." />
    <link rel="canonical" href="https://dagnelli.net/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Operation: Pineapple — Meet Daniele" />
    <meta property="og:description" content="Part personal website. Part pixel adventure. A whole lot of pineapple." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dagnelli.net/" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: siteMetadata.name, url: siteMetadata.website, jobTitle: 'Senior Engagement Manager', email: siteMetadata.email, sameAs: [`https://github.com/${siteMetadata.github_handle}`, `https://linkedin.com/in/${siteMetadata.linkedin_handle}`] })} />
  </head>
  <body>
    <a class="skip-link" href="#story">Skip to my story</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Daniele D’Agnelli homepage"><span class="brand-mark" aria-hidden="true">d.</span><span>DANIELE D’AGNELLI<span class="wordmark-sub">A HUMAN, MOSTLY.</span></span></a>
        <nav aria-label="Main navigation"><a href="#story">Read my story <span aria-hidden="true">↗</span></a><a href="mailto:daniele@dagnelli.net">Say ciao <span aria-hidden="true">↗</span></a></nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <div class="hero-title"><p class="eyebrow"><span class="tiny-square"></span> AN INTERACTIVE INTRODUCTION</p><h1 id="page-title">Operation<span class="title-bottom">Pineapple<span class="title-star" aria-hidden="true">✳</span><span class="title-period">.</span></span></h1></div>
          <div class="hero-note"><span class="edition">SIDE QUEST NO. 001</span><p>Science nerd. Music lover. Proud dad. <br />Questionable pizza opinions.</p><p class="hero-description">Get to know me, one little adventure at a time.</p><span class="duration"><span aria-hidden="true">◷</span> 5–8 MINUTES &nbsp; / &nbsp; ZERO PIZZA REGRETS</span></div>
        </section>

        <section class="game-console" id="adventure" aria-label="Operation Pineapple adventure">
          <div class="console-bar"><div class="console-label"><span class="live-dot"></span><span id="room-name">Little Italy, big ideas</span></div><span class="console-coordinates" id="coordinates" aria-hidden="true">226 : 348</span><button id="sound-toggle" type="button" aria-pressed="false"><span aria-hidden="true">♫</span> <span id="sound-label">Music: Off</span></button><label class="volume-control" hidden>Volume<input id="volume" type="range" min="0" max="100" value="28" aria-label="Music volume" /></label></div>
          <div class="console-body">
            <div class="world-column">
              <div class="canvas-wrap">
                <canvas id="world" width="960" height="640" tabindex="0" role="group" aria-label="Playable pixel neighbourhood. Use arrow keys or WASD to walk, E to interact. You can also click a building, or use the Places menu." aria-describedby="control-help">Explore Daniele’s story using the reading section below.</canvas>
                <div class="map-badge" aria-hidden="true"><span>YOU ARE HERE</span><strong id="map-label">THE NEIGHBOURHOOD</strong></div>
                <div class="map-tools"><button id="places-button" type="button" aria-label="Open places menu">⌘ <span>Places</span></button><button id="help-button" type="button" aria-label="How to play">?</button></div>
                <button class="interaction-prompt" id="interact" type="button"><kbd>E</kbd><span id="interact-label">Meet player one</span><span aria-hidden="true">↗</span></button>
                <div id="game-fallback" hidden><p>The neighbourhood couldn’t load in this browser.</p><a href="#story">Read the whole story →</a></div>
              </div>
              <div class="game-controls" id="control-help"><span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> / <span class="arrow-keys">↑ ← ↓ →</span> MOVE</span><span><kbd>E</kbd> INTERACT</span><span class="click-help">OR CLICK TO EXPLORE</span><button id="pause-button" type="button" aria-label="Pause game">Ⅱ</button></div>
              <div class="touch-controls" aria-label="Touch game controls"><div class="dpad"><button type="button" data-direction="up" aria-label="Move up">↑</button><button type="button" data-direction="left" aria-label="Move left">←</button><span aria-hidden="true">✚</span><button type="button" data-direction="right" aria-label="Move right">→</button><button type="button" data-direction="down" aria-label="Move down">↓</button></div><span>WANDER A LITTLE.</span><button type="button" id="touch-interact">A<span>INTERACT</span></button></div>
            </div>
            <aside class="quest-panel" aria-label="Quest and discoveries">
              <div class="quest-heading"><span class="eyebrow">THE MAIN QUEST</span><span class="quest-number">01</span></div>
              <div class="pizza-art" aria-hidden="true"><svg viewBox="0 0 100 90"><path d="M16 13H84V24H78V35H72V46H65V58H58V71H51V82H44V71H38V58H31V46H25V35H19V24H16Z" fill="#f8d76b" stroke="#191e30" stroke-width="4"/><path d="M16 13H84V25H16Z" fill="#d7885b"/><path d="M32 34H43V45H32ZM55 31H66V42H55ZM45 54H56V65H45Z" fill="#e77162"/><path d="M46 32H53V39H46ZM31 47H39V54H31ZM55 45H63V52H55Z" fill="#fff0ae"/></svg><span class="art-spark one">✧</span><span class="art-spark two">✦</span></div>
              <h2 id="quest-title">A pizza fit<br />for a queen.</h2>
              <p id="objective">Three ingredients. One rooftop dinner. My little queen is waiting.</p>
              <ol class="inventory" aria-label="Ingredients to collect">{ingredients.map((item, i) => <li data-ingredient={item.id}><span class="item-icon" aria-hidden="true">{item.symbol}</span><span>{item.name}</span><span class="item-check" aria-label="Not collected">0{i + 1}</span></li>)}</ol>
              <div class="quest-progress"><span id="progress-text">0 OF 3 COLLECTED</span><div class="progress-track" role="progressbar" aria-label="Ingredients collected" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0"><span id="progress-fill"></span></div></div>
              <button id="journal-button" class="journal-button" type="button"><span><span aria-hidden="true">▤</span> My field notes</span><span id="journal-count">01</span></button>
              <p class="quest-footnote">A few things about me.<br />A few things to figure out.</p>
              <div class="save-controls"><span id="save-status">PROGRESS SAVES HERE</span><button id="new-game" type="button">New game ↺</button></div>
            </aside>
          </div>
          <div class="console-footer"><span><span class="tiny-square"></span> BUILT WITH CURIOSITY. TOPPED WITH CONTROVERSY.</span><span id="game-status">NO RUSH. LOOK AROUND.</span></div>
        </section>
        <p class="below-game"><span><span class="lime-dot"></span> Play as me. Discover the person behind the pixels.</span><a href="#story">More of a reader? I’ve got you. ↓</a></p>
        <div id="announcement" class="sr-only" role="status" aria-live="polite"></div>
        <noscript><p class="no-script">The adventure needs JavaScript. My full story is right below—no puzzles required.</p></noscript>

        <section id="story" class="story-section" aria-labelledby="story-heading">
          <div class="story-intro"><p class="eyebrow">BEHIND THE PIXELS</p><h2 id="story-heading">Same person. <br />Fewer side quests.</h2><p>I’m Daniele D’Agnelli. I work in AI and digital transformation in London. But that’s only part of the story.</p><a class="text-link" href="mailto:daniele@dagnelli.net">Let’s talk →</a></div>
          <div class="story-grid">{stories.filter(story => ['science', 'music', 'pizza', 'family'].includes(story.id)).map(story => <article><span class="eyebrow">{story.category}</span><h3>{story.title}</h3><p>{story.text}</p></article>)}</div>
        </section>
        <section class="career-section" aria-labelledby="career-heading"><div class="career-header"><div><p class="eyebrow">THE PROFESSIONAL CHAPTER</p><h2 id="career-heading">Curiosity, put to work.</h2></div><a class="text-link" href={`https://linkedin.com/in/${siteMetadata.linkedin_handle}`}>LinkedIn ↗</a></div><div class="career-list">{experience.map(job => <article><div><h3>{job.company}</h3><span>{job.location}</span></div><div>{job.roles.map(role => <><h4>{role.title}</h4><span class="career-period">{role.period}</span>{role.description && <p>{role.description}</p>}{role.bullets && role.bullets.length > 0 && <ul>{role.bullets.map(bullet => <li>{bullet}</li>)}</ul>}</>)}</div></article>)}</div><div class="education-grid">{education.map(item => <article><p class="eyebrow">{item.period} · {item.location}</p><h3>{item.degree}</h3><p>{item.institution}{item.distinction ? ` · ${item.distinction}` : ''}</p></article>)}</div><details class="skills-list"><summary>Open the toolbox <span>+</span></summary><p>{skills.join(' · ')}</p><p>{languages.join(' · ')}</p></details></section>
      </main>
      <footer class="site-footer"><a class="wordmark" href="#page-title"><span class="brand-mark" aria-hidden="true">d.</span><span>STAY CURIOUS.<span class="wordmark-sub">AND ORDER WHAT YOU LIKE.</span></span></a><div><a href={`https://github.com/${siteMetadata.github_handle}`}>GitHub ↗</a><a href={`https://linkedin.com/in/${siteMetadata.linkedin_handle}`}>LinkedIn ↗</a><a href="mailto:daniele@dagnelli.net">Say ciao ↗</a></div><span class="footer-note">LONDON, UK · MADE OF MANY INTERESTS</span></footer>
    </div>
    <dialog id="game-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><span id="dialog-category" class="eyebrow">FIELD NOTES</span><button id="close-dialog" type="button" aria-label="Close dialog">×</button></div><h2 id="dialog-title"></h2><div id="dialog-content"></div></dialog>
    <script>
      import { startGame } from '../game/game';
      startGame();
    </script>
  </body>
</html>
