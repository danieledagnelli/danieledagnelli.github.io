<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mirror</title>
<meta name="description" content="A PlayCanvas figure that mirrors your movements through the camera. Everything runs in your browser.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:global>
  :root { color-scheme: dark; --green: #39ff88; --dim: #8a9a90; --x: #ff5a5a; --y: #39ff88; --z: #5aa8ff; }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: #000; color: #e8f5ec; font: 15px/1.5 system-ui, -apple-system, Segoe UI, sans-serif; overflow: hidden; }
  canvas#scene { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  canvas#scene:active { cursor: grabbing; }
  .preview { position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); width: min(28vw, 220px); aspect-ratio: 4 / 3; transform: scaleX(-1); border: 1px solid #1d3a28; border-radius: 8px; overflow: hidden; background: #050805; }
  body.debug .preview { width: min(40vw, 360px); }
  .preview video, .preview canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .preview video { opacity: .85; }
  .panel { position: fixed; inset: 0; display: grid; place-items: center; padding: 16px; text-align: center; background: radial-gradient(circle at 50% 45%, #04140a 0, #000 70%); }
  .panel h1 { margin: 0 0 .25em; font-size: clamp(2rem, 7vw, 3.5rem); letter-spacing: .02em; color: var(--green); text-shadow: 0 0 24px #39ff8855; }
  .panel p { margin: 0 auto 1.5em; max-width: 34em; color: var(--dim); }
  button { font: inherit; color: #001a0a; background: var(--green); border: 0; border-radius: 999px; padding: .75em 1.6em; font-weight: 600; cursor: pointer; }
  button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  button.ghost { background: #000a; color: var(--dim); border: 1px solid #1d3a28; padding: .45em 1em; font-weight: 500; }
  button.ghost[aria-pressed="true"] { color: var(--green); border-color: #2c6b45; }
  .topleft { position: fixed; left: 16px; top: calc(16px + env(safe-area-inset-top, 0px)); max-width: calc(100% - 32px); max-height: calc(100% - 32px); display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
  .topleft > * { pointer-events: auto; }
  .hud { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .chips { flex-basis: 100%; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .chips::before { content: "Add-ons"; color: var(--dim); font-size: 12px; margin-right: 2px; }
  button.chip { font-size: 13px; padding: .3em .85em; }
  .chip .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; background: #444; vertical-align: 1px; }
  .chip[data-status="loading"] .dot { background: #5aa8ff; animation: pulse 1s ease-in-out infinite; }
  .chip[data-status="waiting"] .dot { background: #ffc94a; }
  .chip[data-status="active"] .dot { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .chip[data-status="failed"] .dot { background: #ff5a5a; }
  @keyframes pulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .chip[data-status="loading"] .dot { animation: none; } }
  #status { color: var(--dim); font-size: 13px; }
  .slider { display: inline-flex; align-items: center; gap: 6px; color: var(--dim); font-size: 13px; padding: .3em .8em; border: 1px solid #1d3a28; border-radius: 999px; background: #000a; }
  .slider input { width: 90px; accent-color: var(--green); }
  #status::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; background: #444; vertical-align: 1px; }
  #status.live::before { background: var(--green); box-shadow: 0 0 8px var(--green); }
  #status.frozen::before { background: #ffc94a; box-shadow: 0 0 8px #ffc94a; }
  .readout { width: min(340px, 100%); min-height: 0; flex: 0 1 auto; max-height: calc(100vh - 330px); overflow: auto; padding: 10px 12px; background: #000c; border: 1px solid #1d3a28; border-radius: 8px; font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; color: #b9cfc1; }
  .readout h2 { margin: 8px 0 2px; font: 600 11px/1.4 system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
  .readout h2:first-child { margin-top: 0; }
  .readout table { border-collapse: collapse; width: 100%; }
  .readout td { padding: 0 6px 0 0; white-space: nowrap; }
  .readout td:not(:first-child) { text-align: right; }
  .readout td.wrap { white-space: normal; }
  .readout .x { color: var(--x); } .readout .y { color: var(--y); } .readout .z { color: var(--z); }
  .readout .keys { color: var(--dim); }
  .readout .st-active { color: var(--green); } .readout .st-waiting { color: #ffc94a; }
  .readout .st-loading { color: var(--z); } .readout .st-failed { color: #ff7a7a; } .readout .st-off { color: #5f6f66; }
  .readout kbd { border: 1px solid #2a4434; border-radius: 3px; padding: 0 4px; }
  .checklist { position: fixed; right: 16px; top: calc(16px + env(safe-area-inset-top, 0px)); width: min(330px, calc(100% - 32px)); max-height: calc(100% - 300px); overflow: auto; padding: 10px 12px; background: #000d; border: 1px solid #1d3a28; border-radius: 8px; font-size: 12.5px; line-height: 1.35; color: #cfe0d5; }
  .checklist h2 { margin: 0 0 4px; font-size: 13px; color: var(--green); display: flex; justify-content: space-between; gap: 8px; }
  .checklist .sum { color: var(--dim); font-weight: 400; }
  .checklist h3 { margin: 8px 0 2px; font: 600 11px/1.4 system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
  .checklist ul { list-style: none; margin: 0; padding: 0; }
  .checklist li { display: grid; grid-template-columns: 1.2em auto 1fr; gap: 0 6px; padding: 2px 0; align-items: baseline; }
  .checklist .ic { font-weight: 700; text-align: center; }
  .checklist .nt { grid-column: 2 / -1; color: var(--dim); font-size: 11.5px; }
  .checklist .ok .ic { color: var(--green); }
  .checklist .wait .ic { color: #ffc94a; }
  .checklist .fail .ic { color: #ff6b6b; }
  .checklist .off { opacity: .55; }
  .labels { position: fixed; inset: 0; pointer-events: none; }
  .tag { position: absolute; transform: translate(-50%, -50%); font: 600 12px/1 ui-monospace, monospace; padding: 2px 4px; border-radius: 3px; background: #000b; white-space: nowrap; }
  .tag.R { color: #ffb347; } .tag.L { color: #c49bff; }
  .tag.ax-x { color: var(--x); } .tag.ax-y { color: var(--y); } .tag.ax-z { color: var(--z); }
  .tag.C { color: #fff; }
  .tag.m { font-weight: 500; font-size: 11px; color: #fff3a6; }
  .tag.m.R { color: #ffd59a; } .tag.m.L { color: #ddc8ff; }
  .tag.tick { color: #6f8a78; font-weight: 400; background: none; }
  a { color: var(--green); }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<canvas id="scene" aria-label="3D figure mirroring your pose"></canvas>
<div class="labels" id="labels" aria-hidden="true"></div>
<div class="preview" id="preview" hidden>
  <video id="cam" playsinline muted></video>
  <canvas id="overlay"></canvas>
</div>

<div class="topleft">
<div class="hud" id="hud" hidden>
  <span id="status" role="status">Loading…</span>
  <button class="ghost" id="togglePreview" type="button" aria-pressed="true">Camera</button>
  <button class="ghost" id="toggleDebug" type="button" aria-pressed="true" title="D">Debug</button>
  <button class="ghost" id="toggleChecklist" type="button" aria-pressed="false" title="X">Checklist</button>
  <button class="ghost" id="toggleMeasures" type="button" aria-pressed="true" title="M">3D measures</button>
  <label class="slider" title="Higher is smoother but follows fast moves with a little more delay">Smooth
    <input id="smoothing" type="range" min="0" max="1" step="0.05" aria-label="Smoothing"></label>
  <button class="ghost" id="recenter" type="button" title="Reset view, zoom and pan (R or double-click)">Recenter</button>
  <button class="ghost" id="follow" type="button" aria-pressed="true" title="F">Follow</button>
  <button class="ghost" id="freeze" type="button" aria-pressed="false" title="Space">Freeze</button>
  <button class="ghost" id="stop" type="button">Stop</button>
  <div class="chips" id="features" role="group" aria-label="Add-ons" hidden></div>
</div>

<div class="readout" id="readout" hidden></div>
</div>

<section class="checklist" id="checklist" aria-label="Checklist" aria-live="off" hidden></section>

<div class="panel" id="intro">
  <div>
    <h1>Mirror</h1>
    <p>Step back so your whole body fits in the frame. A PlayCanvas figure will copy your movements like a mirror.
      The video never leaves your device: tracking runs locally in your browser. Face and hand tracking load in the background and switch on by themselves when ready.</p>
    <button id="start" type="button">Turn on camera</button>
    <p id="error" role="alert" style="margin-top:1.25em;color:#ff7a7a" hidden></p>
    <p style="margin-top:2em;font-size:13px"><a href="/">Back to dagnelli.net</a></p>
  </div>
</div>

<script>
  import '../mirror/main.js';
</script>
</body>
</html>
